APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Derrière un reverse proxy (Pangolin, Traefik, Caddy…), indiquer son IP ou son réseau
# (ex. 172.16.0.0/12). Sans cela, tous les visiteurs ont l'IP du proxy : limites de
# tentatives partagées, HTTPS non détecté (pas de HSTS ni de cookies sécurisés).
TRUSTED_PROXIES=
# Workers FrankenPHP (Octane) dans l'image Docker : chacun garde l'application en mémoire.
# OCTANE_WORKERS=2
TRUSTED_HOSTS=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Un fichier par jour, conservé LOG_DAILY_DAYS jours (14 par défaut) au lieu d'un laravel.log sans limite.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (dev) — "mariadb" en prod (docker-compose.yml ne monte plus de fichier SQLite)
DB_CONNECTION=sqlite
# DB_SQLITE_DATABASE=database/database.sqlite

# MariaDB (prod) — utilisé par la connexion "mariadb" et par app:migrate-to-mariadb
# En Docker (docker-compose.yml), DB_HOST doit être le nom du service : "mariadb"
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=deepsky
DB_USERNAME=deepsky
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Dev : file et cache en base. En Docker, l'image fixe déjà Redis
# (QUEUE_CONNECTION, CACHE_STORE, SESSION_DRIVER, REDIS_HOST=redis) :
# ne pas redéfinir ces clés dans le .env de prod, il prendrait le dessus.
QUEUE_CONNECTION=database
# Conversions d'images sur une file dédiée, traitée par le worker "media-worker"
# (docker/supervisord.conf). En dev, composer run dev écoute media,default.
MEDIA_QUEUE=media
# Doit rester supérieur au timeout de PerformAstrophotoConversionsJob (900 s).
# DB_QUEUE_RETRY_AFTER=960
# REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
ADMIN_EMAILS=

IMAGE_DRIVER=imagick

ASTROMETRY_API_KEY=
TURNSTILE_HOSTNAMES=deepsky.nexus
NIGHTSCOPE_WEATHER_DRIVER=open_meteo
NIGHTSCOPE_SEVEN_TIMER_ENABLED=true
# NIGHTSCOPE_SEVEN_TIMER_ENDPOINT=https://www.7timer.info
